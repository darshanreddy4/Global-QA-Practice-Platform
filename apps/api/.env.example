# Copy to .env for local dev, or set these as environment variables in your host
# (Render/Railway/Fly/etc.) for production. Never commit a real .env file.

PORT=4000
NODE_ENV=development

# Must be a long, random, private string in production. The server refuses to
# start in production if this is missing or left at the insecure default.
JWT_SECRET=dev-only-insecure-secret-change-me

# Comma-separated list of allowed frontend origins (no trailing slash), e.g.
# WEB_ORIGIN=https://your-app.vercel.app,https://your-custom-domain.com
WEB_ORIGIN=http://localhost:5173

# Cookie flags — only change these if frontend and API are on DIFFERENT domains.
# Same-domain deployments (recommended) can leave both at their defaults.
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
